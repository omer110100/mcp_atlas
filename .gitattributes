* text=auto
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
# Archived source bytes are used for provenance hashes.
source-data/** -text
dist/*-data.json -text
*.png binary
*.webp binary
*.woff2 binary
# Preserve the exact licensed source bytes recorded in the font manifest.
dist/assets/fonts/*-OFL.txt binary
